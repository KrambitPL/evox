{
  "name": "@evox/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:partial": "playwright test --project=chromium --grep @partial",
    "test:replay": "test -n \"$REPLAY_API_KEY\" && playwright test --project=replay-chromium",
    "test:replay:partial": "test -n \"$REPLAY_API_KEY\" && playwright test --project=replay-chromium --grep @partial",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.4.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "@playwright/test": "1.61.1",
    "@replayio/playwright": "5.0.3"
  }
}
