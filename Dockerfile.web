FROM node:24-trixie-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/web/package.json packages/web/package.json
RUN pnpm install --frozen-lockfile
COPY packages/web packages/web
RUN pnpm --filter @evox/web build
RUN pnpm --filter @evox/web --fail-if-no-match deploy --prod --legacy /runtime \
    && cp -R packages/web/.next /runtime/.next \
    && /bin/rm -f /runtime/next.config.ts

FROM node:24-trixie-slim
ARG REVISION
LABEL org.opencontainers.image.source="https://github.com/KrambitPL/evox" \
      org.opencontainers.image.revision="$REVISION"
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --create-home --uid 10001 evox
RUN /bin/rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg
COPY --from=build --chown=evox:evox /runtime ./
USER 10001
EXPOSE 3000
CMD ["./node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
